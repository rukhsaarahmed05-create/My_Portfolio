{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "module": "NodeNext",
    "target": "ES2020",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@server/*": ["./server/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "types": ["node", "vite/client"]
  },
  "include": ["server/**/*", "shared/**/*", "api/**/*", "client/src/**/*"],
  "exclude": ["node_modules", "dist", "build", "**/*.test.ts"]
}

